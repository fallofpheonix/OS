    log_fail "Invalid module path: $raw_path"
    exit 1
  fi

  log_info "Running benchmarks for module at $m_path..."
  if [ ! -f "$m_path/benchmark.sh" ]; then
    log_skip "benchmark.sh not found in $m_path. Skipping benchmark."
    return 0
  fi

  mkdir -p "$m_path/artifacts"
  cd "$m_path"
