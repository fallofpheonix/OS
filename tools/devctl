#!/bin/bash
# PhoenixOS devctl - Development Orchestrator CLI
# Enforces the 12-stage engineering lifecycle

# Colors
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[0;33m'
GRAY='\033[0;90m'
NC='\033[0m' # No Color

# Helper functions
log_pass() { echo -e "${GREEN}[PASS]${NC} $1"; }
log_fail() { echo -e "${RED}[FAIL]${NC} $1"; }
log_skip() { echo -e "${YELLOW}[SKIP]${NC} $1"; }
log_info() { echo -e "${GRAY}[$(date +%H:%M:%S)]${NC} $1"; }

resolve_path() {
  local input_path="$1"
  if [ -z "$input_path" ]; then
    echo ""
    return
  fi
  # If absolute path
  if [[ "$input_path" = /* ]]; then
    if [ -d "$input_path" ]; then
      echo "$input_path"
      return
    fi
  fi
  # Check if exists in current dir
  if [ -d "$input_path" ]; then
    echo "$(pwd)/$input_path"
    return
  fi
  # Check if exists in phoenix_os/
  local workspace_dir="/Users/fallofpheonix/os"
  if [ -d "$workspace_dir/phoenix_os/$input_path" ]; then
    echo "$workspace_dir/phoenix_os/$input_path"
    return
  fi
  echo ""
}

# command: create
cmd_create() {
  local name="$1"
  if [ -z "$name" ]; then
    log_fail "Module name is required for create command."
    exit 1
  fi

  local target_dir="/Users/fallofpheonix/os/phoenix_os/$name"
  if [ -d "$target_dir" ]; then
    log_fail "Module directory already exists: $target_dir"
    exit 1
  fi

  log_info "Creating module '$name' at $target_dir..."
  mkdir -p "$target_dir"
  cp -r /Users/fallofpheonix/os/tools/module_template/* "$target_dir"/

  # Create subdirectories and .gitkeep
  for subdir in src tests bench replay debug artifacts; do
    mkdir -p "$target_dir/$subdir"
    touch "$target_dir/$subdir/.gitkeep"
  done

  # Replace placeholders using perl (Mac/Linux compatible)
  find "$target_dir" -type f -exec perl -pi -e "s/__MODULE_NAME__/$name/g" {} +

  # Make shell scripts executable
  chmod +x "$target_dir"/*.sh 2>/dev/null || true

  log_pass "Module '$name' created successfully."
}

# command: build
cmd_build() {
  local raw_path="$1"
  local m_path=$(resolve_path "$raw_path")
  if [ -z "$m_path" ]; then
    log_fail "Invalid module path: $raw_path"
    exit 1
  fi

  log_info "Building module at $m_path..."
  if [ ! -f "$m_path/build.sh" ]; then
    log_fail "build.sh not found in $m_path"
    exit 1
  fi

  mkdir -p "$m_path/artifacts"
  cd "$m_path"
  set +e
  ./build.sh > artifacts/build_devctl.log 2>&1
  local code=$?
  set -e
  cd - > /dev/null

  if [ $code -eq 0 ]; then
    log_pass "Build passed."
    return 0
  else
    log_fail "Build failed. Check $m_path/artifacts/build_devctl.log"
    return 1
  fi
}

# command: test
cmd_test() {
  local raw_path="$1"
  local m_path=$(resolve_path "$raw_path")
  if [ -z "$m_path" ]; then
    log_fail "Invalid module path: $raw_path"
    exit 1
  fi

  log_info "Running tests for module at $m_path..."
  if [ ! -f "$m_path/test.sh" ]; then
    log_fail "test.sh not found in $m_path"
    exit 1
  fi

  mkdir -p "$m_path/artifacts"
  cd "$m_path"
  set +e
  ./test.sh > artifacts/test_devctl.log 2>&1
  local code=$?
  set -e
  cd - > /dev/null

  if [ $code -eq 0 ]; then
    log_pass "Tests passed."
    return 0
  else
    log_fail "Tests failed. Check $m_path/artifacts/test_devctl.log"
    return 1
  fi
}

