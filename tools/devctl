  set -e
  cd - > /dev/null

  if [ $code -eq 0 ]; then
    log_pass "Benchmarks completed."
    return 0
  else
    log_fail "Benchmarks failed. Check $m_path/artifacts/benchmark_devctl.log"
    return 1
  fi
}

