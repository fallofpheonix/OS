# command: lifecycle
cmd_lifecycle() {
  local raw_path="$1"
  local m_path=$(resolve_path "$raw_path")
  if [ -z "$m_path" ]; then
    log_fail "Invalid module path: $raw_path"
    exit 1
  fi

  log_info "Starting full engineering lifecycle for module: $(basename $m_path)"
  local b_res="FAIL"
  local t_res="FAIL"
  local bn_res="SKIP"
  local r_res="SKIP"
  local v_res="SKIP"

  if cmd_build "$raw_path"; then
    b_res="PASS"
    if cmd_test "$raw_path"; then
      t_res="PASS"
      if [ -f "$m_path/benchmark.sh" ]; then
        if cmd_bench "$raw_path"; then bn_res="PASS"; else bn_res="FAIL"; fi
      fi
      if [ "$bn_res" != "FAIL" ]; then
        if [ -f "$m_path/replay.sh" ]; then
          if cmd_replay "$raw_path"; then r_res="PASS"; else r_res="FAIL"; fi
        fi
      fi
      if [ "$bn_res" != "FAIL" ] && [ "$r_res" != "FAIL" ]; then
        if [ -f "$m_path/validate.sh" ]; then
          if cmd_validate "$raw_path"; then v_res="PASS"; else v_res="FAIL"; fi
        fi
      fi
    fi
  fi

  # Generate lifecycle report JSON
  local status_json="{\"module\":\"$(basename $m_path)\",\"build\":\"$b_res\",\"test\":\"$t_res\",\"bench\":\"$bn_res\",\"replay\":\"$r_res\",\"validate\":\"$v_res\"}"
  mkdir -p "$m_path/artifacts"
  echo "$status_json" > "$m_path/artifacts/lifecycle_report.json"

  echo "=================================================="
  echo "LIFECYCLE SUMMARY FOR $(basename $m_path):"
  echo "  BUILD:    $b_res"
  echo "  TEST:     $t_res"
  echo "  BENCH:    $bn_res"
  echo "  REPLAY:   $r_res"
  echo "  VALIDATE: $v_res"
  echo "=================================================="

  if [ "$b_res" = "PASS" ] && [ "$t_res" = "PASS" ] && [ "$bn_res" != "FAIL" ] && [ "$r_res" != "FAIL" ] && [ "$v_res" != "FAIL" ]; then
    log_pass "Full lifecycle passed!"
    return 0
  else
    log_fail "Lifecycle failed at one or more stages."
    exit 1
  fi
}

# command: status
cmd_status() {
  local raw_path="$1"
  if [ -n "$raw_path" ]; then
    local m_path=$(resolve_path "$raw_path")
    if [ -z "$m_path" ]; then
      log_fail "Invalid module path: $raw_path"
      exit 1
    fi
    echo -e "Module: $(basename $m_path)"
    for stage in build test benchmark replay validate; do
      local sh_file="$m_path/$stage.sh"
      if [ "$stage" = "benchmark" ]; then sh_file="$m_path/benchmark.sh"; fi
      if [ ! -f "$sh_file" ]; then
        echo -e "  $stage: ${YELLOW}SKIP${NC} (missing script)"
      else
        # check if run passed before
        local log_file="$m_path/artifacts/${stage}_devctl.log"
        if [ -f "$log_file" ]; then
          if grep -q "FAIL" "$log_file" || grep -q "Error" "$log_file" || grep -q "exit status" "$log_file"; then
            echo -e "  $stage: ${RED}FAIL${NC}"
          else
            echo -e "  $stage: ${GREEN}PASS${NC}"
          fi
        else
          echo -e "  $stage: ${GRAY}--${NC}"
        fi
      fi
    done
  else
    # Scan phoenix_os recursively (1 level deep) for directories containing README.md or build.sh
    echo -e "Module\t\t\tBuild\tTest\tBench\tReplay\tValidate"
    echo -e "------------------------------------------------------------"
    local workspace_dir="/Users/fallofpheonix/os/phoenix_os"
    # Find all subdirectories that have build.sh or are standard modules
    for d in "$workspace_dir"/*; do
      if [ -d "$d" ]; then
        # Check if it has a build.sh or src dir
        if [ -f "$d/build.sh" ] || [ -d "$d/src" ] || [ -f "$d/entropy.go" ]; then
          local mod_name=$(basename "$d")
          # Check statuses
          local b_status="${GRAY}--${NC}"
          local t_status="${GRAY}--${NC}"
          local bn_status="${GRAY}--${NC}"
          local r_status="${GRAY}--${NC}"
          local v_status="${GRAY}--${NC}"

          # Read lifecycle_report.json if exists
          if [ -f "$d/artifacts/lifecycle_report.json" ]; then
            # Simple parsing using grep/sed
            local report=$(cat "$d/artifacts/lifecycle_report.json")
            local b_val=$(echo "$report" | grep -o '"build":"[^"]*"' | cut -d'"' -f4)
            local t_val=$(echo "$report" | grep -o '"test":"[^"]*"' | cut -d'"' -f4)
            local bn_val=$(echo "$report" | grep -o '"bench":"[^"]*"' | cut -d'"' -f4)
            local r_val=$(echo "$report" | grep -o '"replay":"[^"]*"' | cut -d'"' -f4)
            local v_val=$(echo "$report" | grep -o '"validate":"[^"]*"' | cut -d'"' -f4)

            colorize() {
              if [ "$1" = "PASS" ]; then echo -e "${GREEN}PASS${NC}";
              elif [ "$1" = "FAIL" ]; then echo -e "${RED}FAIL${NC}";
              elif [ "$1" = "SKIP" ]; then echo -e "${YELLOW}SKIP${NC}";
              else echo -e "${GRAY}--${NC}"; fi
            }
            b_status=$(colorize "$b_val")
            t_status=$(colorize "$t_val")
            bn_status=$(colorize "$bn_val")
            r_status=$(colorize "$r_val")
            v_status=$(colorize "$v_val")
          fi
          echo -e "$mod_name\t\t$b_status\t$t_status\t$bn_status\t$r_status\t$v_status"
        fi
      fi
    done
    # Also check subdirectories of phoenix_os/bus/ if normalizer is in bus/normalizer
    if [ -d "$workspace_dir/bus/normalizer" ]; then
      local d="$workspace_dir/bus/normalizer"
      local mod_name="bus/normalizer"
      local b_status="${GRAY}--${NC}"
      local t_status="${GRAY}--${NC}"
      local bn_status="${GRAY}--${NC}"
      local r_status="${GRAY}--${NC}"
      local v_status="${GRAY}--${NC}"

      if [ -f "$d/artifacts/lifecycle_report.json" ]; then
        local report=$(cat "$d/artifacts/lifecycle_report.json")
        local b_val=$(echo "$report" | grep -o '"build":"[^"]*"' | cut -d'"' -f4)
        local t_val=$(echo "$report" | grep -o '"test":"[^"]*"' | cut -d'"' -f4)
        local bn_val=$(echo "$report" | grep -o '"bench":"[^"]*"' | cut -d'"' -f4)
        local r_val=$(echo "$report" | grep -o '"replay":"[^"]*"' | cut -d'"' -f4)
        local v_val=$(echo "$report" | grep -o '"validate":"[^"]*"' | cut -d'"' -f4)

        colorize() {
          if [ "$1" = "PASS" ]; then echo -e "${GREEN}PASS${NC}";
          elif [ "$1" = "FAIL" ]; then echo -e "${RED}FAIL${NC}";
          elif [ "$1" = "SKIP" ]; then echo -e "${YELLOW}SKIP${NC}";
          else echo -e "${GRAY}--${NC}"; fi
        }
        b_status=$(colorize "$b_val")
        t_status=$(colorize "$t_val")
        bn_status=$(colorize "$bn_val")
        r_status=$(colorize "$r_val")
        v_status=$(colorize "$v_val")
      fi
      echo -e "$mod_name\t\t$b_status\t$t_status\t$bn_status\t$r_status\t$v_status"
    fi
  fi
}

cmd_report() {
  local raw_path="$1"
  local m_path=$(resolve_path "$raw_path")
  if [ -z "$m_path" ]; then
    log_fail "Invalid module path: $raw_path"
    exit 1
  fi
  if [ -f "$m_path/artifacts/lifecycle_report.json" ]; then
    cat "$m_path/artifacts/lifecycle_report.json"
  else
    log_fail "No lifecycle report found. Run 'devctl lifecycle $raw_path' first."
    exit 1
  fi
}

# Main command dispatcher
case "$1" in
  create)
    cmd_create "$2"
    ;;
  build)
    cmd_build "$2"
    ;;
  test)
    cmd_test "$2"
    ;;
  bench)
    cmd_bench "$2"
    ;;
  replay)
    cmd_replay "$2"
    ;;
  validate)
    cmd_validate "$2"
    ;;
  lifecycle)
    cmd_lifecycle "$2"
    ;;
  status)
    cmd_status "$2"
    ;;
  report)
    cmd_report "$2"
    ;;
  *)
    echo "Usage: devctl <command> [module_path]"
    echo ""
    echo "Commands:"
    echo "  create <name>       Scaffold a new module from template"
    echo "  lifecycle <path>    Run full lifecycle on a module"
    echo "  build <path>        Build module, capture artifacts"
    echo "  test <path>         Run all tests"
    echo "  bench <path>        Run benchmarks"
    echo "  replay <path>       Run replay (3 deterministic runs)"
    echo "  validate <path>     Validate all gates"
    echo "  status [path]       Show lifecycle status of module(s)"
    echo "  report <path>       Generate lifecycle report"
    exit 1
    ;;
esac
