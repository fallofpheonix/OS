  mkdir -p "$m_path/artifacts"
  cd "$m_path"
  set +e
  ./validate.sh > artifacts/validate_devctl.log 2>&1
  local code=$?
  set -e
  cd - > /dev/null

  if [ $code -eq 0 ]; then
    log_pass "Validation passed."
