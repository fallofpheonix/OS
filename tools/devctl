cmd_replay() {
  local raw_path="$1"
  local m_path=$(resolve_path "$raw_path")
  if [ -z "$m_path" ]; then
    log_fail "Invalid module path: $raw_path"
    exit 1
  fi

  log_info "Running replay for module at $m_path..."
  if [ ! -f "$m_path/replay.sh" ]; then
    log_skip "replay.sh not found in $m_path. Skipping replay."
    return 0
  fi

  mkdir -p "$m_path/artifacts"
  cd "$m_path"
  set +e
  ./replay.sh > artifacts/replay_devctl.log 2>&1
  local code=$?
  set -e
  cd - > /dev/null

  if [ $code -eq 0 ]; then
    log_pass "Replay passed (deterministic)."
    return 0
  else
    log_fail "Replay failed. Check $m_path/artifacts/replay_devctl.log"
    return 1
  fi
}

