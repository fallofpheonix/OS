{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phoenix Normalized Event",
  "type": "object",
  "properties": {
    "timestamp": {"type": "number"},
    "pid": {"type": "integer"},
    "comm": {"type": "string"},
    "type": {"type": "string", "enum": ["WRITE","RENAME","EXEC","OTHER"]},
    "path": {"type": "string"},
    "bytes": {"type": "integer"},
    "entropy": {"type": ["number", "null"]},
    "alert_level": {"type": ["string", "null"]}
  },
  "required": ["timestamp","pid","comm","type","path"]
}
