{
  "": "http://json-schema.org/draft-07/schema#",
  "title": "Ecosystem Event",
  "type": "object",
  "required": [
    "event_id",
    "timestamp",
    "subsystem",
    "severity",
    "type"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "subsystem": {
      "type": "string"
    },
    "severity": {
      "enum": [
        "INFO",
        "WARNING",
        "ERROR",
        "CRITICAL"
      ]
    },
    "type": {
      "type": "string"
    },
    "details": {
      "type": "object"
    }
  }
}