{
  "": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "type": {
      "enum": [
        "app",
        "module",
        "service",
        "sdk",
        "infra",
        "tooling"
      ]
    },
    "language": {
      "type": "string"
    },
    "maturity": {
      "enum": [
        "experimental",
        "incubating",
        "stable",
        "production",
        "frozen",
        "deprecated"
      ]
    },
    "status": {
      "type": "string"
    },
    "local_path": {
      "type": "string"
    },
    "visibility": {
      "enum": [
        "PUBLIC",
        "PRIVATE"
      ]
    }
  },
  "required": [
    "name",
    "type",
    "language",
    "maturity",
    "status",
    "local_path",
    "visibility"
  ]
}