{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phoenix Telemetry Event",
  "type": "object",
  "required": [
    "timestamp",
    "event_id",
    "category",
    "event_type",
    "host_id",
    "pid",
    "ppid",
    "uid",
    "gid",
    "comm",
    "exe_path"
  ],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "event_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "category": {
      "type": "string",
      "enum": ["process", "syscall", "filesystem", "network", "container", "memory"]
    },
    "event_type": {
      "type": "string"
    },
    "host_id": {
      "type": "string"
    },
    "pid": {
      "type": "integer",
      "minimum": 0
    },
    "ppid": {
      "type": "integer",
      "minimum": 0
    },
    "uid": {
      "type": "integer",
      "minimum": 0
    },
    "gid": {
      "type": "integer",
      "minimum": 0
    },
    "comm": {
      "type": "string"
    },
    "exe_path": {
      "type": "string"
    },
    "container_id": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "category": { "const": "process" } }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["args", "env_vars"],
            "properties": {
              "args": {
                "type": "array",
                "items": { "type": "string" }
              },
              "env_vars": {
                "type": "array",
                "items": { "type": "string" }
              },
              "exit_code": { "type": "integer" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "category": { "const": "syscall" } }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["syscall_nr", "args", "retval"],
            "properties": {
              "syscall_nr": { "type": "integer", "minimum": 0 },
              "args": {
                "type": "array",
                "items": { "type": "integer" },
                "maxItems": 6
              },
              "retval": { "type": "integer" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "category": { "const": "filesystem" } }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["file_path", "flags", "mode", "bytes_requested", "bytes_transferred"],
            "properties": {
              "file_path": { "type": "string" },
              "flags": { "type": "integer", "minimum": 0 },
              "mode": { "type": "integer", "minimum": 0 },
              "bytes_requested": { "type": "integer", "minimum": 0 },
              "bytes_transferred": { "type": "integer" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "category": { "const": "network" } }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["saddr", "daddr", "sport", "dport", "protocol"],
            "properties": {
              "saddr": { "type": "string" },
              "daddr": { "type": "string" },
              "sport": { "type": "integer", "minimum": 0, "maximum": 65553 },
              "dport": { "type": "integer", "minimum": 0, "maximum": 65553 },
              "protocol": { "type": "string", "enum": ["TCP", "UDP", "RAW"] },
              "state_change": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "category": { "const": "container" } }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["namespace_pid", "namespace_net", "namespace_mnt", "cgroup_path"],
            "properties": {
              "namespace_pid": { "type": "integer", "minimum": 0 },
              "namespace_net": { "type": "integer", "minimum": 0 },
              "namespace_mnt": { "type": "integer", "minimum": 0 },
              "cgroup_path": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "category": { "const": "memory" } }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["address", "length", "protection", "flags"],
            "properties": {
              "address": { "type": "integer", "minimum": 0 },
              "length": { "type": "integer", "minimum": 0 },
              "protection": { "type": "integer", "minimum": 0 },
              "flags": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    }
  ]
}
