# ==============================================================================
# PHOENIX MATRIX: Boot-Time Invariants Contract
# ==============================================================================
# This file defines the absolute environmental state required for ignition.
# Duplicate this file to '.env' and secure it before launch.

# --- Clock and Ledger State ---
# The monotonic starting tick for the Lamport Clock. Must be strictly increasing.
PHOENIX_LOGICAL_CLOCK_START=0
# Cryptographic seed for the genesis block of the append-only ledger.
PHOENIX_GENESIS_SEED=00000000000000000000000000000000

# --- Advisory Thresholds ---
# The absolute minimum confidence score (0.0 to 1.0) before Mind can propose.
PHOENIX_CONFIDENCE_FLOOR=0.85

# --- Guard Enforcement Limits ---
# The absolute maximum duration (in seconds) a guard action can execute before rollback.
PHOENIX_ROLLBACK_TIMEOUT=30

# --- Cluster Authority ---
# Primary PoA key identifier for cluster governance validation.
PHOENIX_CONSENSUS_AUTHORITY_KEY=warden_primary_key_v1
