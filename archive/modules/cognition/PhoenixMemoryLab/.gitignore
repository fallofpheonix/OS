# ============================================
# Brain Repository .gitignore
# Invariant: brain = cognition only
# ============================================

# === Runtime artifacts (NEVER in brain) ===
node_modules/
venv/
.venv/
build/
dist/
target/
__pycache__/
*.pyc
*.pyo
*.o
*.a
*.so
*.dylib
*.exe
*.class
*.jar
package-lock.json
yarn.lock
pnpm-lock.yaml

# === Executable project scaffolds (NOT cognition) ===
engineering/active/
runtime/

# === Environment and secrets ===
.env
.env.*

# === Obsidian local state (NOT knowledge) ===
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache/

# === Obsidian plugin data / embeddings ===
.smart-env/

# === AI tool local state ===
.claude/
.claudian/

# === OS artifacts ===
.DS_Store
*.log
Thumbs.db

# === Tests directory (empty scaffold) ===
tests/
